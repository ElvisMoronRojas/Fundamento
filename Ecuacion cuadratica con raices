#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    double x1, y1, x2, y2, x3, y3;
    double D, h, k, radio;

    cout << "Ingrese las coordenadas del punto A (x1 y1): ";
    cin >> x1 >> y1;

    cout << "Ingrese las coordenadas del punto B (x2 y2): ";
    cin >> x2 >> y2;

    cout << "Ingrese las coordenadas del punto C (x3 y3): ";
    cin >> x3 >> y3;

    
    D = 2 * (x1 * (y2 - y3) +
             x2 * (y3 - y1) +
             x3 * (y1 - y2));

   
    if (fabs(D) < 1e-9) {
        cout << "Los tres puntos estan alineados." << endl;
        cout << "No existe una circunferencia unica que pase por los tres puntos." << endl;
        return 0;
    }

   
    h = ((x1 * x1 + y1 * y1) * (y2 - y3) +
         (x2 * x2 + y2 * y2) * (y3 - y1) +
         (x3 * x3 + y3 * y3) * (y1 - y2)) / D;

    k = ((x1 * x1 + y1 * y1) * (x3 - x2) +
         (x2 * x2 + y2 * y2) * (x1 - x3) +
         (x3 * x3 + y3 * y3) * (x2 - x1)) / D;

    radio = sqrt((x1 - h) * (x1 - h) +
                 (y1 - k) * (y1 - k));

    cout << fixed << setprecision(2);
    cout << "\nCentro de la circunferencia: (" << h << ", " << k << ")" << endl;
    cout << "Radio: " << radio << endl;

    return 0;
}
