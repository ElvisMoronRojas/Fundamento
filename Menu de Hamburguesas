#include <iostream>
using namespace std;

int main()
{
   
   float b=3, cb=5, p=2, s=2.5, ch, chq, cp, cs, totalp = 0;
   int opcion; 
   
   cout<<"Menu"<<endl;
   cout<<"1. Hamburguesa (3Bs): "<<endl;
   cout<<"2. Hamburguesa con queso (5Bs): "<<endl;
   cout<<"3. Papas fritas (2Bs): "<<endl;
   cout<<"4. Soda (2.5Bs): "<<endl;
   cout<<"0. Salir "<<endl;
   cout<<"Escoja una opcion: ";
   cin>>opcion;
   
    switch (opcion)
    {
       case 1:
           cout<<"Introduzca la cantidad de Hamburguesa: ";
           cin>>ch;
           totalp=ch*b;
           break;
       case 2:
           cout<<"Introduzca la cantidad de Hamburguesa con queso: ";
           cin>>chq; 
           totalp=chq*cb;
           break;
       case 3:
           cout<<"Introduzca la cantidad de papas fritas: ";
           cin>>cp; 
           totalp=cp*p;
           break;
       case 4:
           cout<<"Introduzca la cantidad de soda: ";
           cin>>cs; 
           totalp=cs*s;
           break;
       case 0:
           cout<<"Saliendo del programa..."<<endl;
           return 0;
           
       default: 
           cout<<"Opcion invalida."<<endl;
           return 0;
           break;
    }
    
   cout<<"El total a pagar es: "<<totalp<<" Bs."<<endl;
   return 0;
}
