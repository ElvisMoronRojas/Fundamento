#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float lado1, lado2, lado3, semi, area;
    cout<< "Ingrese el primer lado del triangulo: ";cin>>lado1;
    cout<< "Ingrese el segundo lado triangulo: ";cin>>lado2;
    cout<< "Ingrese el tercer lado triangulo: ";cin>>lado3;
    semi= (lado1+lado2+lado3)/2;
    area=sqrt(semi*(semi-lado1)*(semi-lado2)*(semi-lado3));
    cout<< "El area del triangulo es: "<<area;

    return 0;
}
