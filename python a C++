//Funciones
bool es_digito_str(const string& s) {
	if (s.empty()) return false;
	for (char c : s) {
		if (!isdigit(c)) return false;
	}
	return true;
}
bool validar_fecha(string fecha) {
	if (fecha.length() != 10 || fecha[2] != '/' || fecha[5] != '/') {
		return false;
	}
	string d_str = fecha.substr(0, 2);
	string m_str = fecha.substr(3, 2);
	string a_str = fecha.substr(6, 4);
	if (!es_digito_str(d_str) || !es_digito_str(m_str) || !es_digito_str(a_str)) {
		return false;
	}

	int dia = stoi(d_str);
	int mes = stoi(m_str);
	int anio = stoi(a_str);

	if (anio < 1 || mes < 1 || mes > 12) {
		return false;
	}

	int dias = 0;
	if (mes == 2) {
		if (anio % 400 == 0 || (anio % 4 == 0 && anio % 100 != 0)) {
			dias = 29;
		}
		else {
			dias = 28;
		}
	}
	else if (mes == 4 || mes == 6 || mes == 9 || mes == 11) {
		dias = 30;
	}
	else {
		dias = 31;
	}

	if (dia < 1 || dia > dias) {
		return false;
	}

	return true;
}

void registrar_usuario() {
	cout << "--- REGISTRAR USUARIO ---" << endl;
	string usuario, clave;
	cout << "Ingrese usuario: ";
	getline(cin, usuario);

	for (const auto& u : usuarios) {
		if (u[0] == usuario) {
			cout << "El usuario ya existe." << endl;
			return;
		}
	}

	cout << "Ingrese contraseña: ";
	getline(cin, clave);
	usuarios.push_back({ usuario, clave });
	cout << "Usuario registrado correctamente." << endl;
}
void listar_usuarios() {
	cout << "--- LISTA DE USUARIOS ---" << endl;

	if (usuarios.empty()) {
		cout << "No hay usuarios registrados." << endl;
	}
	else {
		for (size_t i = 0; i < usuarios.size(); ++i) {
			cout << "Usuario Nro: " << i + 1 << endl;
			cout << "Usuario: " << usuarios[i][0] << endl;
		}
	}
}
void modificar_usuario() {
	cout << "--- MODIFICAR USUARIO ---" << endl;
	string nombre;
	cout << "Ingrese el usuario que desea modificar: ";
	getline(cin, nombre);

	for (auto& u : usuarios) {
		if (u[0] == nombre) {
			string nuevo_nombre, nueva_clave;
			cout << "Nuevo nombre de usuario: ";
			getline(cin, nuevo_nombre);
			cout << "Nueva contraseña: ";
			getline(cin, nueva_clave);

			u[0] = nuevo_nombre;
			u[1] = nueva_clave;
			cout << "Usuario modificado correctamente." << endl;
			return;
		}
	}

	cout << "Usuario no encontrado." << endl;
}
void borrar_usuario() {
	cout << "--- BORRAR USUARIO ---" << endl;
	string nombre;
	cout << "Ingrese el usuario que desea eliminar: ";
	getline(cin, nombre);

	for (auto it = usuarios.begin(); it != usuarios.end(); ++it) {
		if ((*it)[0] == nombre) {
			usuarios.erase(it);
			cout << "Usuario eliminado correctamente." << endl;
			return;
		}
	}

	cout << "Usuario no encontrado." << endl;
}
bool login() {
	cout << "--- INICIAR SESION ---" << endl;
	string usuario, clave;
	cout << "Usuario: ";
	getline(cin, usuario);
	cout << "Contraseña: ";
	getline(cin, clave);

	for (const auto& u : usuarios) {
		if (u[0] == usuario && u[1] == clave) {
			cout << "Bienvenido " << usuario << endl;
			return true;
		}
	}

	cout << "Usuario o contraseña incorrectos." << endl;
	return false;
}
void registrar_persona() {
	cout << "--- REGISTRAR PERSONA ---" << endl;

	string nombre, fecha, ci, direccion, telefono;

	cout << "Nombre: ";
	getline(cin, nombre);

	cout << "Fecha de nacimiento (DD/MM/AAAA): ";
	getline(cin, fecha);

	while (!validar_fecha(fecha)) {
		cout << "Fecha incorrecta. Ingrese una fecha real." << endl;
		cout << "Fecha de nacimiento (DD/MM/AAAA): ";
		getline(cin, fecha);
	}

	cout << "CI: ";
	getline(cin, ci);
	cout << "Direccion: ";
	getline(cin, direccion);
	cout << "Telefono: ";
	getline(cin, telefono);

	personas.push_back({ nombre, fecha, ci, direccion, telefono });
	cout << "Persona registrada correctamente." << endl;
}
